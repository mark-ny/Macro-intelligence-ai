ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# Free key: https://twelvedata.com (used by the ICT module)
TWELVEDATA_API_KEY=your-twelvedata-api-key

# Free key, no card required: https://currentsapi.services (News module)
CURRENTS_API_KEY=your-currents-api-key

# https://aistudio.google.com/apikey (AI assistant chat widget)
GEMINI_API_KEY=your-gemini-api-key

# Any long random string — must match the secret set in the GitHub Actions
# repo secrets as REFRESH_TOKEN (see .github/workflows/scheduled-refresh.yml)
REFRESH_TOKEN=change-me
